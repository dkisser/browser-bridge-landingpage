# ===== 部署参数（scripts/deploy.sh 读取）=====
# 复制为项目根 .env 后填入真实值；.env 已 gitignore，不要提交

# SSH 连接
DEPLOY_HOST=114.215.198.209
DEPLOY_USER=root
DEPLOY_SSH_PORT=22
# 私钥文件路径（不是私钥本身；留空则走 ssh-agent / 默认密钥）
DEPLOY_SSH_KEY=/Users/wenchen/Documents/PaulBlog/paul-blog.pem

# rsync 目标目录（服务器上的宿主机路径）
# 硬约束：必须与服务器 docker-compose.yml 里 Caddy 的挂载源完全一致
DEPLOY_PATH=/home/paul/landingpage

# 服务器上 compose 项目所在目录（Caddyfile 与 docker-compose.yml 的存放位置）
DEPLOY_REMOTE_ROOT=/home/paul/blog

# 前置检查用的标识符，必须与服务器上 Caddyfile 的写法逐字匹配：
#   DEPLOY_SITE_HOST      → Caddyfile 里的 site 块域名
#   DEPLOY_CONTAINER_ROOT → Caddyfile 里 root * 的容器内路径（compose 中的挂载点）
DEPLOY_SITE_HOST=browser-bridge.dkisser.cn
DEPLOY_CONTAINER_ROOT=/srv/landingpage
